# TRACE backend configuration. Copy to .env and fill in as needed.
# Every value has a working default, so the app runs with no .env at all.

# --- HTTP -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
TRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- upload limits ----------------------------------------------------------
TRACE_MAX_UPLOAD_BYTES=5242880
TRACE_MAX_EVENTS=20000

# --- AI investigator (OPTIONAL) ---------------------------------------------
# Leave TRACE_LLM_API_KEY empty to run the deterministic fallback investigator.
# The app never depends on this being set.
TRACE_LLM_API_KEY=
TRACE_LLM_BASE_URL=https://api.openai.com/v1
TRACE_LLM_MODEL=gpt-4o-mini
TRACE_LLM_TIMEOUT=12

# --- parser -----------------------------------------------------------------
# Year assumed for syslog-style timestamps that omit a year.
TRACE_DEFAULT_LOG_YEAR=2026
